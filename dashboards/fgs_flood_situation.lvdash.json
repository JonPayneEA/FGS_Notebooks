{
  "datasets": [
    {
      "name": "kpi",
      "displayName": "Headline numbers",
      "queryLines": [
        "SELECT\n",
        "  (SELECT COUNT(*) FROM prd_dash_lab.flood_forecasting_unrestricted.constituency_flood_situation WHERE fgs_worst_rank >= 3) AS at_risk_medium_or_above,\n",
        "  (SELECT COUNT(*) FROM prd_dash_lab.flood_forecasting_unrestricted.constituency_flood_situation WHERE fgs_escalated) AS escalated,\n",
        "  (SELECT COUNT(*) FROM prd_dash_lab.flood_forecasting_unrestricted.constituency_flood_situation WHERE has_active_warning) AS with_warning_or_alert\n"
      ]
    },
    {
      "name": "situation",
      "displayName": "Constituencies to watch",
      "queryLines": [
        "SELECT constituency_name, mp_name, mp_party, fgs_worst_level, fgs_worst_rank, fgs_worst_date,\n",
        "       fgs_worst_sources, fgs_escalated, severe_warnings, warnings, alerts\n",
        "FROM prd_dash_lab.flood_forecasting_unrestricted.constituency_flood_situation\n",
        "WHERE fgs_worst_rank >= 2 OR has_active_warning\n",
        "ORDER BY fgs_worst_rank DESC, severe_warnings DESC, warnings DESC, constituency_name\n"
      ]
    },
    {
      "name": "changes",
      "displayName": "Escalations in the latest statement",
      "queryLines": [
        "SELECT constituency_name, forecast_date, source, previous_rank, new_rank, change_type\n",
        "FROM prd_dash_lab.flood_forecasting_unrestricted.fgs_constituency_changes\n",
        "WHERE statement_id = (SELECT MAX(statement_id) FROM prd_dash_lab.flood_forecasting_unrestricted.fgs_constituency_changes)\n",
        "  AND change_type IN ('escalated', 'new')\n",
        "ORDER BY new_rank DESC, constituency_name\n"
      ]
    },
    {
      "name": "exposure",
      "displayName": "Most exposed constituencies, last 12 months",
      "queryLines": [
        "SELECT constituency_name, SUM(days_medium_or_above) AS days_medium_or_above\n",
        "FROM prd_dash_lab.flood_forecasting_unrestricted.fgs_constituency_exposure\n",
        "WHERE source = 'any' AND month >= date_format(add_months(current_date(), -12), 'yyyy-MM')\n",
        "GROUP BY constituency_name\n",
        "ORDER BY days_medium_or_above DESC\n",
        "LIMIT 20\n"
      ]
    },
    {
      "name": "health",
      "displayName": "Pipeline health",
      "queryLines": [
        "SELECT check_name, status, value, detail, checked_at\n",
        "FROM prd_dash_lab.flood_forecasting_unrestricted.pipeline_health\n",
        "ORDER BY CASE status WHEN 'fail' THEN 0 WHEN 'warn' THEN 1 WHEN 'info' THEN 2 ELSE 3 END, check_name\n"
      ]
    }
  ],
